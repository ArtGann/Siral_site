{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siral-site",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "siralstrategy.com",
      "custom_domain": true
    }
  ]
}
